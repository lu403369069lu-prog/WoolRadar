+    def test_local_file_commit_failure_recovers_without_second_delivery_write(self):
+        with tempfile.TemporaryDirectory(dir=TEMP) as td:
+            root = Path(td)
+            db = Database(root / 'radar.db')
+            event = db.upsert_candidate(Candidate('n', 'rss', 'Notice', 'https://vendor.example/notice')).event_id
+            queue = NotificationQueue(db)
+            self.assertTrue(queue.enqueue(event, '', 'local', 'notice'))
+            destination = root / 'outbox' / 'notification-1.json'
+            original_connect = db.connect
+            fail_once = [True]
+
+            @contextmanager
+            def fail_first_sent_commit():
+                with original_connect() as conn:
+                    yield conn
+                    if fail_once[0] and destination.exists() and conn.execute(
+                            "SELECT result FROM notifications WHERE id=1").fetchone()['result'] == 'SENT':
+                        fail_once[0] = False
+                        raise sqlite3.OperationalError('injected COMMIT failure before durability')
+
+            original_replace = Path.replace
+            replacements = []
+
+            def count_replace(path, target):
+                if Path(target) == destination:
+                    replacements.append(str(path))
+                return original_replace(path, target)
+
+            with patch.object(db, 'connect', fail_first_sent_commit), patch.object(Path, 'replace', count_replace):
+                self.assertEqual(queue.flush({}, local_dir=root / 'outbox')['retry'], 1)
+                self.assertEqual(json.loads(destination.read_text(encoding='utf-8'))['message'], 'notice')
+                with original_connect() as conn:
+                    conn.execute('UPDATE notifications SET next_attempt=0 WHERE id=1')
+                self.assertEqual(queue.flush({}, local_dir=root / 'outbox')['local'], 1)
+
+            self.assertEqual(len(replacements), 1, 'retry must not replace an already delivered identical file')
+            with original_connect() as conn:
+                self.assertEqual(conn.execute('SELECT result FROM notifications WHERE id=1').fetchone()['result'], 'SENT')
+
+    def test_expired_local_claim_cannot_overwrite_newer_delivery(self):
+        with tempfile.TemporaryDirectory(dir=TEMP) as td:
+            root = Path(td)
+            db = Database(root / 'radar.db')
+            event = db.upsert_candidate(Candidate('n', 'rss', 'Notice', 'https://vendor.example/notice')).event_id
+            queue = NotificationQueue(db)
+            self.assertTrue(queue.enqueue(event, '', 'local', 'old payload'))
+            entered = threading.Event()
+            release = threading.Event()
+            failures = []
+            original_write = Path.write_text
+
+            def pause_first_worker(path, *args, **kwargs):
+                if threading.current_thread().name == 'expired-local-worker' and path.suffix == '.tmp':
+                    entered.set()
+                    if not release.wait(5):
+                        raise AssertionError('replacement worker did not finish')
+                return original_write(path, *args, **kwargs)
+
+            def old_worker():
+                try:
+                    queue.flush({}, local_dir=root / 'outbox')
+                except BaseException as exc:
+                    failures.append(exc)
+
+            with patch.object(Path, 'write_text', pause_first_worker):
+                thread = threading.Thread(target=old_worker, name='expired-local-worker')
+                thread.start()
+                try:
+                    self.assertTrue(entered.wait(5), 'old worker should be paused before disk write')
+                    with db.connect() as conn:
+                        conn.execute("UPDATE notifications SET next_attempt=0,payload='new payload' WHERE result='CLAIMED'")
+                    self.assertEqual(NotificationQueue(Database(db.path)).flush({}, local_dir=root / 'outbox')['local'], 1)
+                finally:
+                    release.set()
+                    thread.join(5)
+            self.assertFalse(thread.is_alive())
+            self.assertEqual(failures, [])
+            notices = list((root / 'outbox').glob('notification-*.json'))
+            self.assertEqual(len(notices), 1)
+            self.assertEqual(json.loads(notices[0].read_text(encoding='utf-8'))['message'], 'new payload')
+            with db.connect() as conn:
+                row = conn.execute('SELECT result,attempts FROM notifications').fetchone()
+            self.assertEqual((row['result'], row['attempts']), ('SENT', 2))
+
